rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownUser() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function enabled() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && ownUser().data.disabled != true;
    }

    function role() {
      return enabled() ? ownUser().data.role : null;
    }

    function isAdmin() {
      return role() == 'admin';
    }

    function isOrganizer() {
      return role() in ['organizer', 'admin'];
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function onlyChanged(keys) {
      return request.resource.data.diff(resource.data).changedKeys().hasOnly(keys);
    }

    match /users/{uid} {
      allow create: if isOwner(uid)
        && request.resource.data.uid == uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.role in ['student', 'organizer']
        && request.resource.data.disabled == false;

      allow read: if isOwner(uid) || isOrganizer();

      allow update: if enabled()
        && (
          (
            isOwner(uid)
            && request.resource.data.role == resource.data.role
            && request.resource.data.disabled == resource.data.disabled
          )
          || isAdmin()
        );

      allow delete: if isAdmin();
    }

    match /events/{eventId} {
      allow read: if true;

      allow create: if enabled()
        && isOrganizer()
        && request.resource.data.organizerId == request.auth.uid;

      allow update: if enabled()
        && (
          isAdmin()
          || resource.data.organizerId == request.auth.uid
          || onlyChanged(['seatsAvailable', 'registrationCount'])
        );

      allow delete: if isAdmin();
    }

    match /registrations/{ticketId} {
      allow create: if enabled()
        && request.resource.data.ticketId == ticketId
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'active';

      allow read: if enabled()
        && (resource.data.userId == request.auth.uid || isOrganizer());

      allow update: if enabled()
        && (
          isAdmin()
          || resource.data.userId == request.auth.uid
          || isOrganizer()
        );

      allow delete: if isAdmin();
    }

    match /attendance/{ticketId} {
      allow read: if enabled() && isOrganizer();
      allow create: if enabled() && isOrganizer();
      allow update, delete: if false;
    }

    match /notifications/{id} {
      allow create: if enabled() && isOrganizer();
      allow read, update: if enabled()
        && (resource.data.userId == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }

    match /contactMessages/{id} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }
  }
}
